<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8.0+). The launcher masks these two layers to
     whatever shape the device uses — circle, squircle, teardrop — and moves
     them independently, which is why the mark ships on transparency over a
     flat background rather than as one pre-composed square. Devices below
     API 26 fall back to mipmap-*/ic_launcher.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
