# Loaded automatically by `npm run build` (Vite's default mode is "production").
# Single source of truth for the admin panel's deployed backend URL — the
# doubled "api" is deliberate: the production domain's reverse proxy adds its
# own "/api" on top of this app's own "/api/v1" route prefix. Must match
# ../backend/src/TrafficJam.Api/appsettings.Production.json's Api:PublicBaseUrl.
VITE_API_BASE_URL=https://trafficjam-live.kaizeninfotech.com/api/api/v1
